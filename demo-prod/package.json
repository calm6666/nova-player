    "@lumina/plugins": "workspace:*",
    "dashjs": "^5.1.1",
    "flv.js": "^1.6.2",
    "hls.js": "link:../packages/plugins/hls"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vite": "^5.2.0"
  }
}
