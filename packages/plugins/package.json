{
  "name": "@lumina/plugins",
  "version": "1.0.0",
  "description": "Lumina official plugins collection",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./danmaku": {
      "import": "./dist/danmaku.js",
      "types": "./dist/danmaku.d.ts"
    },
    "./subtitle": {
      "import": "./dist/subtitle.js",
      "types": "./dist/subtitle.d.ts"
    },
    "./dash": {
      "import": "./dist/dash.js",
      "types": "./dist/dash.d.ts"
    },
    "./hls": {
      "import": "./dist/hls.js",
      "types": "./dist/hls.d.ts"
    },
    "./flv": {
      "import": "./dist/flv.js",
      "types": "./dist/flv.d.ts"
    },
    "./top": {
      "import": "./dist/top.js",
      "types": "./dist/top.d.ts"
    },
    "./ending": {
      "import": "./dist/ending.js",
      "types": "./dist/ending.d.ts"
    },
    "./music": {
      "import": "./dist/music.js",
      "types": "./dist/music.d.ts"
    },
    "./audioeffect": {
      "import": "./dist/audioeffect.js",
      "types": "./dist/audioeffect.d.ts"
    },
    "./interaction": {
      "import": "./dist/interaction.js",
      "types": "./dist/interaction.d.ts"
    },
    "./interactive-video": {
      "import": "./dist/interactive-video.js",
      "types": "./dist/interactive-video.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node ../../scripts/minify-dist.mjs dist",
    "preview": "vite preview",
    "lint": "node ../../scripts/lint.mjs src --ext .ts",
    "typecheck": "tsc --noEmit",
    "lint:fix": "node ../../scripts/lint.mjs src --ext .ts --fix"
  },
  "keywords": [
    "video-player",
    "plugins",
    "danmaku",
    "subtitle",
    "interaction",
    "dash",
    "hls",
    "flv"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@lumina/nova": "workspace:*"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.1",
    "dashjs": "^5.1.1",
    "flv.js": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^6.0.3",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  }
}
