{
  "name": "@lumina/vite-plugin-lumina-compile",
  "version": "2.0.0",
  "description": "Lumina h() 编译插件（v2 静态骨架 + v1 收尾），可白名单编译指定文件",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ../../scripts/build-lumina-compile-plugin.mjs"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "license": "MIT"
}
