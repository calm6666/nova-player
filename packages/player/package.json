{
  "name": "@lumina/nova",
  "version": "1.0.0",
  "description": "Nova video player built on the Lumina framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lumina": "./dist/lumina.js",
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --mode lib-cdn && sass src/styles/style.scss dist/style.css --no-source-map --style=compressed && node ../../scripts/minify-dist.mjs dist",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "video-player",
    "typescript",
    "core"
  ],
  "license": "MIT",
  "devDependencies": {
    "sass": "^1.99.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^3.8.0"
  },
  "dependencies": {
    "lottie-web": "^5.13.0"
  }
}
