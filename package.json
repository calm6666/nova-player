{
  "name": "lumina",
  "version": "2.0.0",
  "description": "Lumina reactive framework + Nova video player (pnpm workspace)",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo",
    "demo-prod"
  ],
  "scripts": {
    "demo": "node demo/server.mjs",
    "demo:live": "vite --config demo/live-player-demo/vite.config.ts",
    "preview": "vite preview",
    "build": "pnpm run build:all",
    "build:all": "pnpm --filter @lumina/framework run build && pnpm --filter @lumina/nova run build && pnpm --filter @lumina/plugins run build && pnpm --filter @lumina/live-player run build && pnpm --filter @lumina/demo run build && pnpm --filter demo-prod run build",
    "build:framework": "pnpm --filter @lumina/framework run build",
    "build:player": "pnpm --filter @lumina/nova run build",
    "build:plugins": "pnpm --filter @lumina/plugins run build",
    "build:live": "pnpm --filter @lumina/live-player run build",
    "build:demo": "pnpm --filter @lumina/demo run build",
    "build:demo-prod": "pnpm --filter demo-prod run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs packages --ext .ts",
    "lint:fix": "node scripts/lint.mjs packages --ext .ts --fix",
    "demo:ssr": "node demo/server.mjs",
    "demo:csr": "vite --config demo/vite.config.ts --port 5175 --open"
  },
  "keywords": [
    "video-player",
    "typescript",
    "h-function",
    "lightweight",
    "lumina"
  ],
  "author": "",
  "license": "MIT",
  "sideEffects": false,
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@babel/types": "^8.0.0",
    "@lumina/framework": "workspace:*",
    "@lumina/live-player": "workspace:*",
    "@lumina/nova": "workspace:*",
    "@lumina/plugins": "workspace:*",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.28.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "express": "^5.2.1",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "magic-string": "^0.30.21",
    "prettier": "^3.3.0",
    "sass": "^1.99.0",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "vite": "^5.2.0",
    "vitest": "^2.1.9"
  }
}
