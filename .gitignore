# ============================================
# 依赖
# ============================================
node_modules/

# ============================================
# 构建产物
# ============================================
dist/

# ============================================
# 操作系统
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# 环境变量 / 密钥
# ============================================
.env
.env.local
.env.*.local

# ============================================
# 工具临时产物
# ============================================
# pnpm 内容寻址存储 / 依赖缓存：不入库
.pnpm-store/
# Vite 配置时间戳临时文件
*.timestamp-*.mjs
# 无头浏览器临时用户目录
.chrome-tmp/
# mock-server 运行时拉取的媒体缓存（测试视频/雪碧图二进制）：不入库
mock-server/.cache/
# 互动视频演示用的测试视频（ffmpeg 生成的二进制，共约 36MB）：不入库，
# 需要时用 ffmpeg testsrc2 重新生成（data.json 引用 n1/n2a/n2b/n3.mp4）
mock-server/interactive/videos/
# IDE 工具会话目录
.trae/
# 早期独立播放器演示页（已废弃，主 demo 在 demo/ 根）
demo/player-demo/

# 演示用 AI 模型二进制（MediaPipe 分割模型 / sherpa-onnx ASR 模型与
# wasm 运行时，共 60+MB）：不入库，下载方式见 docs/api.md 6.5.1 / 6.6.2
demo/public/asr/
demo/public/mediapipe/

# ============================================
# 日志
# ============================================
*.log
npm-debug.log*
pnpm-debug.log*


